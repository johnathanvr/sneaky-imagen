# RunPod Serverless API Key (obtain from Console > Settings > API Keys)
RUNPOD_API_KEY=your_runpod_api_key_here

# RunPod Serverless Endpoints for each model type
# You can deploy separate serverless endpoints for each model size to optimize GPU usage and cost.
RUNPOD_ENDPOINT_ID_SD15=your_sd15_endpoint_id_here
RUNPOD_ENDPOINT_ID_SDXL=your_sdxl_endpoint_id_here
RUNPOD_ENDPOINT_ID_FLUX=your_flux_endpoint_id_here

# Optional: Password to protect access to the web app
# If set, users will be prompted to enter this password to generate images.
APP_PASSWORD=
